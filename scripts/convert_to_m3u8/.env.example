# Path to the source MP4 file. Quotes allow spaces in paths.
MP4_FILE="/absolute/path/to/movie.mp4"

# Folder where master.m3u8 and quality folders will be created.
# It must be empty or not exist yet.
OUTPUT_DIR="/absolute/path/to/movie_hls"

# Comma-separated bitrate profiles/output folders. Every output retains the
# source video's exact width and height; profiles change bitrate only.
# Available values:
# 240p, 360p, 480p, 720p, 1080p, 1440p, 2160p
VIDEO_QUALITIES="360p,480p,720p,1080p"

# Target duration of each .ts segment in seconds.
SEGMENT_SECONDS=4
# Put multiple keyframes inside each segment so progressive HLS playback can
# decode a GOP before the full TS segment has downloaded.
KEYFRAME_SECONDS=1

# Lower CRF makes larger, higher-quality video. 24 is a balanced smaller output.
VIDEO_CRF=24
# Encoding is done one quality at a time; keep this low on memory-constrained hosts.
VIDEO_THREADS=2
# medium is smaller than veryfast at the same CRF, with reasonable speed.
ENCODER_PRESET="medium"
# NVIDIA NVENC preset used by script_gpu.sh (p1 fastest, p7 highest quality).
GPU_PRESET="p4"
AUDIO_BITRATE="96k"
