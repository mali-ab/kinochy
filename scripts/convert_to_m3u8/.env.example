# Path to the source MP4 file. Quotes allow spaces in paths.
MP4_FILE="/absolute/path/to/movie.mp4"

# Folder where master.m3u8 and quality folders will be created.
# It must be empty or not exist yet.
OUTPUT_DIR="/absolute/path/to/movie_hls"

# Comma-separated output qualities. Available values:
# 240p, 360p, 480p, 720p, 1080p, 1440p, 2160p
VIDEO_QUALITIES="360p,480p,720p,1080p"

# Target duration of each .ts segment in seconds.
SEGMENT_SECONDS=6

# Optional encoder settings.
ENCODER_PRESET="veryfast"
AUDIO_BITRATE="128k"
