# Only needed for development. In production the site is served together with
# the admin panel behind the nginx edge (docker-compose), so the relative
# default /admin works out of the box.
#
# During development the admin SPA runs on its own Vite server:
#   npm run dev:admin        (from the repository root)
# Point the site's Admin link at it:
NEXT_PUBLIC_ADMIN_URL=http://localhost:5174/admin
