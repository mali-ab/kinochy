# Copy to .deploy.env and fill in. This file is git-ignored.

# SSH connection
DEPLOY_HOST=your.server.ip
DEPLOY_USER=kinochy
DEPLOY_PORT=22
DEPLOY_PATH=/home/kinochy/kinochy
# DEPLOY_SSH_KEY=~/.ssh/id_ed25519
# DEPLOY_SSH_PASSWORD=
DEPLOY_STRICT_HOST_KEY_CHECKING=accept-new

# Local images are built with Docker Compose, uploaded over SSH, then started remotely.
# The local and server Docker platforms must match (for example linux/amd64).
# Remote compose command
DEPLOY_COMPOSE_FILE=docker-compose.yml
DEPLOY_COMPOSE_CMD='docker compose'
# Set DEPLOY_DELETE=1 to remove server files that no longer exist locally.
DEPLOY_DELETE=0

# Local app env file uploaded as <DEPLOY_PATH>/.env.
# Leave empty to keep the server's existing .env untouched.
DEPLOY_APP_ENV=.env

# Optional post-deploy check
# DEPLOY_HEALTH_URL=http://your.server.ip:4000/api/health
