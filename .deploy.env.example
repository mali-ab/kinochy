# Copy to .deploy.env and fill in. This file is git-ignored.

# SSH connection
DEPLOY_HOST=your.server.ip
DEPLOY_USER=kinochy
DEPLOY_PORT=22
DEPLOY_PATH=/home/kinochy/kinochy
# DEPLOY_SSH_KEY=~/.ssh/id_ed25519
# DEPLOY_SSH_PASSWORD=
# Optional: server sudo password. Stored only in this ignored local env file.
# Leave empty if DEPLOY_USER already has passwordless sudo.
# DEPLOY_SUDO_PASSWORD=
DEPLOY_STRICT_HOST_KEY_CHECKING=accept-new

# Native deployment: systemd runs the API and host Nginx serves the built admin
# SPA and proxies API/media. The application is not run in Docker.
DEPLOY_NGINX_SITE_NAME=kinochy
# Set this to the domain or IP visitors use in their browser.
DEPLOY_SERVER_NAME=kinochy.zehinli.biz
# HTTPS uses the existing ZeroSSL certificate files configured in deploy.sh.
# Private API port used only between Nginx and the API on this server.
DEPLOY_API_PORT=7001

# deploy.sh installs PostgreSQL on the server and creates this database and role.
POSTGRES_DB=kinochy
POSTGRES_USER=kinochy
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Local app env file uploaded as <DEPLOY_PATH>/.env. It must define
# JWT_SECRET and MOVIE_STORAGE_PATH. deploy.sh generates DATABASE_URL from the
# PostgreSQL settings above and keeps it in a root-readable system env file.
# Leave empty to keep the server's existing .env untouched.
DEPLOY_APP_ENV=.env

# DNS for DEPLOY_SERVER_NAME must point to the server, with inbound ports 80/443
# open. Server must use Debian/Ubuntu with Node.js/npm, .NET 10 SDK, Nginx,
# systemd, and the configured certificate files. Set DEPLOY_SUDO_PASSWORD or grant DEPLOY_USER passwordless sudo.
