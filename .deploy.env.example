# Copy to .deploy.env and fill in. This file is git-ignored.

# SSH connection
DEPLOY_HOST=your.server.ip
DEPLOY_USER=kinochy
DEPLOY_PORT=22
DEPLOY_PATH=/home/kinochy/kinochy
# DEPLOY_SSH_KEY=~/.ssh/id_ed25519
# DEPLOY_SSH_PASSWORD=
DEPLOY_STRICT_HOST_KEY_CHECKING=accept-new

# Native deployment: the API runs as a systemd service, host Nginx serves the
# built admin SPA and proxies API/media. PostgreSQL may remain in Compose and
# is bound to localhost:5432 for the native API.
DEPLOY_COMPOSE_FILE=docker-compose.yml
DEPLOY_COMPOSE_CMD='docker compose'
DEPLOY_NGINX_SITE_NAME=kinochy
# Set this to the domain or IP visitors use in their browser.
DEPLOY_SERVER_NAME=your.server.ip
DEPLOY_API_PORT=4000

# Local app env file uploaded as <DEPLOY_PATH>/.env.
# Leave empty to keep the server's existing .env untouched.
DEPLOY_APP_ENV=.env

# Server must have .NET 10 runtime, Nginx, Docker Compose for PostgreSQL,
# systemd, and passwordless sudo for installing the unit/site configuration.
