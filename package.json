{
  "name": "kinochy-workspace",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "dotnet run --project backend",
    "dev:admin": "npm run dev --prefix admin",
    "dev:server": "dotnet run --project backend",
    "build:admin": "npm run build --prefix admin",
    "start": "dotnet run --project backend --no-build",
    "format": "prettier --write . && dotnet csharpier format backend",
    "format:check": "prettier --check . && dotnet csharpier check backend",
    "format:backend": "dotnet csharpier format backend",
    "format:backend:check": "dotnet csharpier check backend"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "prettier": "^3.6.2"
  }
}
